# Package the static release binary with the OpenWrt 25.12 SDK.
include $(TOPDIR)/rules.mk

PKG_NAME:=udpstp
PKG_VERSION:=@VERSION@
PKG_RELEASE:=2

PKG_SOURCE:=udpstp-v$(PKG_VERSION)-x86_64-unknown-linux-musl.tar.gz
PKG_SOURCE_URL:=https://github.com/pederbe/udpstp/releases/download/v$(PKG_VERSION)
PKG_HASH:=@HASH@
PKG_BUILD_DIR:=$(BUILD_DIR)/udpstp-v$(PKG_VERSION)-x86_64-unknown-linux-musl
PKG_LICENSE:=MIT OR Apache-2.0
PKG_LICENSE_FILES:=LICENSE-MIT LICENSE-APACHE
PKG_MAINTAINER:=Peder Bergan

# Preserve the qualified release executable unchanged.
STRIP:=:
RSTRIP:=:

include $(INCLUDE_DIR)/package.mk

define Package/udpstp
  SECTION:=net
  CATEGORY:=Network
  TITLE:=Authenticated network capacity measurement
  URL:=https://udpstp.com
  DEPENDS:=@TARGET_x86_64
endef

define Package/udpstp/description
  Client and Server for the UDP Speed Test Protocol (RFC 9946).
  The Server is started manually. No service or firewall rule is installed.
endef

define Package/udpstp-server
  SECTION:=net
  CATEGORY:=Network
  TITLE:=udpstp Server service
  URL:=https://udpstp.com
  DEPENDS:=+udpstp +procd
  USERID:=udpstp:udpstp
endef

define Package/udpstp-server/description
  Optional procd service for the udpstp Server, disabled until configured.
endef

define Package/udpstp-server/conffiles
/etc/config/udpstp
/etc/udpstp-server/server.toml
endef

define Package/udpstp-server/postinst
#!/bin/sh
if [ -z "$${IPKG_INSTROOT}" ] && [ "$${PKG_UPGRADE}" = 1 ]; then
	/etc/init.d/udpstp-server restart
fi
exit 0
endef

define Build/Configure
endef

define Build/Compile
endef

define Package/udpstp/install
	$(INSTALL_DIR) $(1)/usr/bin $(1)/usr/share/licenses/udpstp
	$(INSTALL_BIN) $(PKG_BUILD_DIR)/udpstp $(1)/usr/bin/udpstp
	$(INSTALL_DATA) $(PKG_BUILD_DIR)/LICENSE-MIT $(PKG_BUILD_DIR)/LICENSE-APACHE \
		$(PKG_BUILD_DIR)/THIRD-PARTY-LICENSES.md $(1)/usr/share/licenses/udpstp/
endef

define Package/udpstp-server/install
	$(INSTALL_DIR) $(1)/etc/init.d $(1)/etc/config $(1)/etc/udpstp-server
	$(INSTALL_BIN) ./files/udpstp-server.init $(1)/etc/init.d/udpstp-server
	$(INSTALL_CONF) ./files/udpstp.config $(1)/etc/config/udpstp
	$(INSTALL_DATA) ./files/server.toml $(1)/etc/udpstp-server/server.toml
endef

$(eval $(call BuildPackage,udpstp))
$(eval $(call BuildPackage,udpstp-server))
