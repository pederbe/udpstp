#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
	local enabled
	config_load udpstp
	config_get_bool enabled server enabled 0
	[ "$enabled" -eq 1 ] || return 0

	local config=/etc/udpstp-server/server.toml
	local keys=/etc/udpstp-server/keys.toml
	if [ ! -r "$config" ] || [ ! -r "$keys" ]; then
		echo 'udpstp-server: configure server.toml and a private keys.toml in /etc/udpstp-server before starting' >&2
		return 1
	fi

	procd_open_instance
	procd_set_param command /usr/bin/udpstp server --config "$config" --key-file "$keys"
	procd_set_param user udpstp
	procd_set_param group udpstp
	procd_set_param limits core="0 0"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file "$config" "$keys"
	procd_set_param term_timeout 10
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger udpstp
}
